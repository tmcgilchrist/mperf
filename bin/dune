; Builds the mperf-stat CLI. This rule is not promoted, so release builds
; (`dune build -p`, as opam runs) still build and install it. The root dune
; file copies the result to ./mperf-stat for `sudo ./mperf-stat`.

(rule
 (target mperf-stat)
 (deps ../apple_perf_stat.c)
 (enabled_if
  (= %{system} macosx))
 (action
  (run %{cc} -O2 -Wall -Wextra -std=c11 -o %{target} %{deps})))

(install
 (section bin)
 (package apple-perf-stat)
 (enabled_if
  (= %{system} macosx))
 (files mperf-stat))
