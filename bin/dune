; Builds the mperf CLI. This rule is not promoted, so release builds
; (`dune build -p`, as opam runs) still build and install it. The root dune
; file copies the result to ./mperf for `sudo ./mperf`.

(rule
 (target mperf)
 (deps ../mperf.c)
 (enabled_if
  (= %{system} macosx))
 (action
  (run %{cc} -O2 -Wall -Wextra -std=c11 -o %{target} %{deps})))

(install
 (section bin)
 (package macperf)
 (enabled_if
  (= %{system} macosx))
 (files mperf))
